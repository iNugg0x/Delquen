#include <windows.h>

// Ícone da aplicação (aparece no Explorador, na barra de tarefas, na janela e na bandeja)
1 ICON "delquen.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Delquen - FPS overlay"
            VALUE "ProductName", "Delquen"
            VALUE "FileVersion", "2.1.0"
            VALUE "ProductVersion", "2.1.0"
            VALUE "OriginalFilename", "delquen.exe"
            VALUE "InternalName", "delquen"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
